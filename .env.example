# =========================================================================
# INDIE SUMMER ATELIER — PRODUCTION ENVIRONMENT CONFIGURATION
# Copy this file to .env.local and populate with your production keys.
# =========================================================================

# 1. Supabase Database, Auth & Realtime CDN Credentials
# Project Dashboard: https://supabase.com/dashboard/project/gqvmdrtlocvidjtiyycv/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://gqvmdrtlocvidjtiyycv.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_publishable_key_here

# 2. Razorpay Live / Sandbox Payment Gateway Credentials
# Merchant Dashboard: https://dashboard.razorpay.com/app/keys
# (Leave blank or unset to run in Atelier Sandbox Simulator test mode)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx

# 3. Transactional Email & Provenance Invoices (Resend / SendGrid / Postmark)
# Get API key: https://resend.com/api-keys
# (Falls back to development simulator queue if unset)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# 4. Automated SMS & WhatsApp Dispatch Notifications (Twilio / Gupshup)
# Console: https://console.twilio.com
# (Falls back to development simulator queue if unset)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# 5. Web Analytics & Conversion Tracking
# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# Meta (Facebook / Instagram) Pixel ID (e.g. 123456789012345)
NEXT_PUBLIC_FB_PIXEL_ID=123456789012345

# 6. Sentry APM & Client/Server Error Monitoring
# Sentry Project Settings: https://sentry.io/settings/projects/
NEXT_PUBLIC_SENTRY_DSN=https://xxxxxxxx@o0000000.ingest.sentry.io/0000000
SENTRY_AUTH_TOKEN=sntrys_xxxxxxxxxxxxxxxxxxxxxxxx
